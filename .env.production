# Production Environment Variables
# Copy this file to .env.prod and update with your production values

# Frontend URL (update with your domain)
FRONTEND_URL=https://rootnote.yourdomain.com

# Backend API URL (optional, uses nginx proxy by default)
VITE_API_URL=

# Logging level (error, warn, info, debug)
LOG_LEVEL=warn

# Backup settings
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7

# Data path (absolute path on host machine)
DATA_PATH=./data/backend

# Database path inside container
DATABASE_PATH=/app/data/rootnote.db
